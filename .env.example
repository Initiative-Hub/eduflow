# Database configuration
DATABASE_URL=YOUR_DATABASE_URL
SHADOW_DATABASE_URL=YOUR_SHADOW_DATABASE_URL

# Better Auth configuration
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Email service configuration
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=YOUR_EMAIL_SERVER_USER
EMAIL_SERVER_PASSWORD=YOUR_EMAIL_SERVER_PASSWORD
EMAIL_FROM=YOUR_EMAIL_FROM

# AWS credentials
AWS_REGION=YOUR_AWS_REGION
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# S3 storage configuration
AWS_S3_ENDPOINT=http://localhost:9000

# OAuth provider credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# AI service API keys
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GOOGLE_GENERATIVE_AI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Upstash Redis configuration
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Markitdown service 
MARKITDOWN_ENDPOINT_URL=http://localhost:8000/markitdown
