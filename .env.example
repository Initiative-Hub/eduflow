# Database configuration
DATABASE_URL=YOUR_DATABASE_URL
SHADOW_DATABASE_URL=YOUR_SHADOW_DATABASE_URL

# Better Auth configuration
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Email service configuration
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=YOUR_EMAIL_SERVER_USER
EMAIL_SERVER_PASSWORD=YOUR_EMAIL_SERVER_PASSWORD
EMAIL_FROM=YOUR_EMAIL_FROM

# AWS Polly credentials
AWS_POLLY_REGION=YOUR_AWS_REGION
AWS_POLLY_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_POLLY_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# AWS S3 credentials
AWS_S3_REGION=YOUR_AWS_REGION
AWS_S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# S3 storage configuration (local)
AWS_S3_ENDPOINT=http://localhost:9000

# AWS Translate credentials
AWS_TRANSLATE_REGION=YOUR_AWS_REGION
AWS_TRANSLATE_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_TRANSLATE_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# OAuth provider credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# AI service API keys
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GOOGLE_GENERATIVE_AI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Upstash Redis configuration
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# External service URL
EXTERNAL_SERVICE_URL=http://localhost:8000

# Merriam-Webster Dictionary API keys
MERRIAM_WEBSTER_COLLEGIATE_API_KEY=YOUR_MERRIAM_WEBSTER_COLLEGIATE_API_KEY
MERRIAM_WEBSTER_LEARNERS_API_KEY=YOUR_MERRIAM_WEBSTER_LEARNERS_API_KEY

# Tavily API configuration
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
