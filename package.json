{
  "name": "eduflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm bun.lock && bunx npkill --delete-all -y",
    "dev": "next dev --turbopack",
    "devx": "bun start:all && bun dev",
    "devrs": "bun start:all && bun db:hardreset && bun dev",
    "build": "bun db:generate && next build --turbopack",
    "start": "next start",
    "start:all": "docker compose up -d",
    "stop": "docker compose down",
    "ws:dev": "partykit dev",
    "ws:deploy": "partykit deploy",
    "email:build": "email build -d ./src/templates/emails",
    "email:dev": "email dev -d ./src/templates/emails -p 3001",
    "email:export": "email export -d ./src/templates/emails",
    "test": " bun db:generate && vitest run",
    "test:watch": "bun db:generate && vitest",
    "type-check": "bun db:generate && tsc --build",
    "ssr-pages:check": "bun scripts/check-ssr-pages.js",
    "i18n:key-parity": "bun scripts/i18n-key-parity.js",
    "i18n:sort": "bun scripts/i18n-sort.js",
    "i18n:sort:check": "bun scripts/i18n-sort.js --check",
    "i18n:sync": "bun scripts/i18n-sync-missing.js",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format-and-lint": "biome check",
    "format-and-lint:fix": "biome check --write",
    "db:reset": "bun --bun prisma migrate reset",
    "db:hardreset": "bun db:reset --force && bun db:generate && bun db:seed",
    "db:format": "bun --bun prisma format",
    "db:status": "bun --bun prisma migrate status",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:seed": "bun --bun prisma db seed",
    "db:studio": "bun --bun prisma studio"
  },
