{
  "name": "eduflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm bun.lock && bunx npkill --delete-all -y",
    "dev": "next dev --turbopack",
    "devx": "bun start:all && bun dev",
    "devrs": "bun start:all && bun db:hardreset && bun dev",
    "build": "bun db:generate && next build --turbopack",
    "start": "next start",
    "start:all": "docker compose up -d",
    "stop": "docker compose down",
    "email:build": "email build -d ./src/templates/emails",
    "email:dev": "email dev -d ./src/templates/emails -p 3001",
    "email:export": "email export -d ./src/templates/emails",
    "mailpit:start": "docker compose up -d mailpit",
    "mailpit:stop": "docker compose down mailpit",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build",
    "i18n:key-parity": "scripts/i18n-key-parity.js",
    "i18n:sort": "bun --bun scripts/i18n-sort.js",
    "i18n:sort:check": "bun --bun scripts/i18n-sort.js --check",
    "i18n:sync": "scripts/i18n-sync-missing.js",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format-and-lint": "biome check",
    "format-and-lint:fix": "biome check --write",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down postgres",
    "db:reset": "bun --bun prisma migrate reset",
    "db:hardreset": "bun db:reset --force && bun db:generate && bun db:seed",
    "db:format": "bun --bun prisma format",
    "db:status": "bun --bun prisma migrate status",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:seed": "bun --bun prisma db seed",
    "db:studio": "bun --bun prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@react-email/components": "1.0.11",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-devtools": "^5.97.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "install": "^0.13.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "prisma": "^7.7.0",
    "react-email": "5.2.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vercel": "^50.42.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "bun@1.3.11"
}
