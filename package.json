{
  "name": "eduflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm bun.lock && bunx npkill --delete-all -y",
    "dev": "bun --bun next dev --turbopack",
    "devx": "bun db:start && bun dev",
    "devrs": "bun db:start && bun db:reset && bun dev",
    "build": "bun --bun next build --turbopack",
    "start": "bun --bun next start",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "type-check": "bun --bun tsc --build",
    "format": "bun --bun biome format",
    "format:fix": "bun --bun biome format --write",
    "lint": "bun --bun biome lint",
    "lint:fix": "bun --bun biome lint --write",
    "format-and-lint": "bun --bun biome check",
    "format-and-lint:fix": "bun --bun biome check --write",
    "db:start": "docker compose -f ./prisma/docker-compose.yml up -d",
    "db:stop": "docker compose -f ./prisma/docker-compose.yml down",
    "db:reset": "bun prisma:reset && bun prisma:generate && bun prisma:seed",
    "prisma:generate": "bun --bun prisma generate",
    "prisma:studio": "bun --bun prisma studio",
    "prisma:format": "bun --bun prisma format",
    "prisma:migrate": "bun --bun prisma migrate dev",
    "prisma:deploy": "bun --bun prisma migrate deploy",
    "prisma:status": "bun --bun prisma migrate status",
    "prisma:reset": "bun --bun prisma migrate reset",
    "prisma:seed": "bun --bun prisma db seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "install": "^0.13.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "prisma": "^7.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.3.11"
}
