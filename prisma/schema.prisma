// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- START BETTER AUTH CORE TABLES (BE CAUTIOUS WHEN MODIFYING THEM) ----

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  roleId        String?
  bio           String?

  // relations
  role         PlatformRole?   @relation(fields: [roleId], references: [id])
  sessions     Session[]
  accounts     Account[]
  posts        Post[]
  files        FileInventory[]
  coursesOwned Course[]        @relation("OwnerCourses")
  enrollments  Enrollment[]
  aiChats      AiChat[]
  aiMessages   AiChatMessage[]
  quizAttempts QuizAttempt[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- END BETTER AUTH CORE TABLES ----

enum PlatformRoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseRoleName {
  OWNER
  TEACHER
  STUDENT
}

enum PlatformPermissionKey {
  MANAGE_USERS
  ENABLE_DISABLE_COURSE
  MANAGE_PLATFORM_SETTINGS
}

enum CoursePermissionKey {
  MANAGE_MEMBERS
  EDIT_CONTENT
  VIEW_ANALYTICS
  GRADE_ASSESSMENTS
}

model PlatformRole {
  id          String               @id @default(uuid())
  name        PlatformRoleName     @unique
  users       User[]
  permissions PlatformPermission[]

  @@map("platform_role")
}

model CourseRole {
  id          String             @id @default(uuid())
  name        CourseRoleName     @unique
  enrollments Enrollment[]
  permissions CoursePermission[]

  @@map("course_role")
}

model PlatformPermission {
  id             String                @id @default(uuid())
  platformRoleId String                @map("platform_role_id")
  platformRole   PlatformRole          @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permission     PlatformPermissionKey
  enabled        Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([platformRoleId, permission])
  @@index([platformRoleId, enabled])
  @@map("platform_permissions")
}

model CoursePermission {
  id           String              @id @default(uuid())
  courseId     String              @map("course_id")
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseRoleId String              @map("course_role_id")
  courseRole   CourseRole          @relation(fields: [courseRoleId], references: [id], onDelete: Cascade)
  permission   CoursePermissionKey
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([courseId, courseRoleId, permission])
  @@index([courseId, courseRoleId, enabled])
  @@map("course_permissions")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

enum FileInventoryStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum AiChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiChatStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum AiChatType {
  CHAT_ASSISTANT
  SOCRATIC_TUTOR
  ENGLISH_ASSISTANT
  WRITING_ASSISTANT
  STUDY_ASSISTANT
}

model FileInventory {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String? @map("course_id")
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentId String?         @map("parent_id")
  parent   FileInventory?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children FileInventory[] @relation("FolderHierarchy")

  name     String
  isFolder Boolean             @default(false) @map("is_folder")
  metadata Json?               @default("{}")
  status   FileInventoryStatus @default(READY)

  fileSize  BigInt? @map("file_size")
  mimeType  String? @map("mime_type")
  extension String? @map("extension")

  bucket         String?
  objectKey      String? @map("object_key")
  checksumSha256 String? @map("checksum_sha256")
  vectorDbId     String? @map("vector_db_id")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  @@index([userId])
  @@index([courseId])
  @@index([parentId])
  @@index([userId, status, uploadedAt(sort: Desc)])
  @@index([courseId, status, uploadedAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@index([courseId, deletedAt])
  @@index([userId, objectKey])
  @@map("file_inventory")
}

model AiChat {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  title     String       @default("")
  type      AiChatType   @default(CHAT_ASSISTANT)
  status    AiChatStatus @default(ACTIVE)
  provider  String?
  model     String?
  metadata  Json?        @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  user     User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, type, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([type, status, updatedAt(sort: Desc)])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String     @id @default(uuid())
  chatId    String     @map("chat_id")
  userId    String?    @map("user_id")
  role      AiChatRole
  parts     Json?      @default("[]")
  provider  String?
  model     String?
  metadata  Json?      @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([role])
  @@map("ai_chat_messages")
}

// ---- Course / Enrollment / Module / Lesson models based on ERD ----
model Course {
  id          String             @id @default(uuid())
  ownerId     String
  owner       User               @relation("OwnerCourses", fields: [ownerId], references: [id])
  title       String
  description String?
  isPublished Boolean            @default(false)
  modules     Module[]
  enrollments Enrollment[]
  permissions CoursePermission[]
  files       FileInventory[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  questions   Question[]
  quizzes     Quiz[]

  @@map("course")
}

model Enrollment {
  id         String     @id @default(uuid())
  memberId   String
  member     User       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId     String
  role       CourseRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  courseId   String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime   @default(now()) @map("enrolled_at")

  @@index([memberId])
  @@index([roleId])
  @@index([courseId, roleId])
  @@index([courseId])
  @@map("enrollment")
}

model Module {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int      @default(0) @map("order_index")
  itemLayout Json?    @map("item_layout")
  lessons    Lesson[]

  @@map("module")
}

model Lesson {
  id         String     @id @default(uuid())
  moduleId   String
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  content    Json?
  orderIndex Int        @default(0) @map("order_index")
  questions  Question[]
  quizzes    Quiz[]

  @@map("lesson")
}

// ─── Quiz System ─────────────────────────────────────────────────────────────

enum QuizCategory {
  SELECTION_BASED
  OPEN_ENDED
}

enum QuestionSubType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  ORDERING
  ESSAY
  FILL_IN_THE_BLANK
  DRAG_AND_DROP
}

enum DeliveryMode {
  INSTANT_FEEDBACK
  POST_QUIZ_REVIEW
}

enum SelectionMethod {
  HAND_PICK
  RANDOM
  MANUAL_CREATE
}

model Question {
  id          String          @id @default(uuid())
  courseId    String          @map("course_id")
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?         @map("lesson_id")
  lesson      Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  category    QuizCategory
  subType     QuestionSubType @map("sub_type")
  prompt      String
  answerData  Json            @map("answer_data")
  explanation String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  quizQuestions QuizQuestion[]

  @@index([courseId])
  @@index([courseId, category, subType])
  @@index([lessonId])
  @@map("question")
}

model Quiz {
  id              String          @id @default(uuid())
  courseId        String          @map("course_id")
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // A quiz can be based on multiple lessons. Use the relation field below.
  lessons         Lesson[]
  title           String
  description     String?
  category        QuizCategory
  subType         QuestionSubType @map("sub_type")
  deliveryMode    DeliveryMode    @map("delivery_mode")
  selectionMethod SelectionMethod @map("selection_method")
  questionCount   Int             @map("question_count")
  questions       Json?           @default("[]")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  quizQuestions QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([courseId])
  @@map("quiz")
}

model QuizQuestion {
  id         String   @id @default(uuid())
  quizId     String   @map("quiz_id")
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0) @map("order_index")

  @@unique([quizId, questionId])
  @@index([quizId])
  @@map("quiz_question")
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers          Json
  score            Float
  maxScore         Float    @map("max_score")
  percentage       Float
  results          Json
  hasPendingReview Boolean  @default(false) @map("has_pending_review")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([quizId, userId])
  @@index([userId])
  @@map("quiz_attempt")
}
