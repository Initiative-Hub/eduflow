// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- START BETTER AUTH CORE TABLES (BE CAUTIOUS WHEN MODIFYING THEM) ----

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  roleId        String?  @map("role_id")
  bio           String?

  // relations
  role                   PlatformRole?           @relation(fields: [roleId], references: [id])
  sessions               Session[]
  accounts               Account[]
  files                  FileInventory[]
  coursesOwned           Course[]                @relation("OwnerCourses")
  enrollments            Enrollment[]
  aiChats                AiChat[]
  aiMessages             AiChatMessage[]
  quizAttempts           QuizAttempt[]
  savedVocabulary        SavedVocabulary[]
  vocabularyLists        VocabularyList[]
  wordbankReviewSessions WordbankReviewSession[]
  wordbankReviewAttempts WordbankReviewAttempt[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ---- END BETTER AUTH CORE TABLES ----

enum PlatformRoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseRoleName {
  COURSE_OWNER
  TEACHER
  STUDENT
}

model PlatformRole {
  id          String               @id @default(uuid())
  name        PlatformRoleName     @unique
  users       User[]
  permissions PlatformPermission[]

  @@map("platform_role")
}

model CourseRole {
  id          String             @id @default(uuid())
  name        CourseRoleName     @unique
  enrollments Enrollment[]
  permissions CoursePermission[]

  @@map("course_role")
}

model PlatformPermission {
  id             String       @id @default(uuid())
  platformRoleId String       @map("platform_role_id")
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permission     String
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([platformRoleId, permission])
  @@index([platformRoleId, enabled])
  @@map("platform_permission")
}

model CoursePermission {
  id           String     @id @default(uuid())
  courseId     String     @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseRoleId String     @map("course_role_id")
  courseRole   CourseRole @relation(fields: [courseRoleId], references: [id], onDelete: Cascade)
  permission   String
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([courseId, courseRoleId, permission])
  @@index([courseId, courseRoleId, enabled])
  @@map("course_permission")
}

enum FileInventoryStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum AiChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiChatStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum AiChatType {
  CHAT_ASSISTANT
  SOCRATIC_TUTOR
  ENGLISH_ASSISTANT
  WRITING_ASSISTANT
  STUDY_ASSISTANT
}

model FileInventory {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String? @map("course_id")
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentId String?         @map("parent_id")
  parent   FileInventory?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children FileInventory[] @relation("FolderHierarchy")

  name     String
  isFolder Boolean             @default(false) @map("is_folder")
  metadata Json?               @default("{}")
  status   FileInventoryStatus @default(READY)

  fileSize  BigInt? @map("file_size")
  mimeType  String? @map("mime_type")
  extension String? @map("extension")

  bucket         String?
  objectKey      String? @map("object_key")
  checksumSha256 String? @map("checksum_sha256")
  vectorDbId     String? @map("vector_db_id")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([userId])
  @@index([courseId])
  @@index([parentId])
  @@index([userId, status, uploadedAt(sort: Desc)])
  @@index([courseId, status, uploadedAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@index([courseId, deletedAt])
  @@index([userId, objectKey])
  @@map("file_inventory")
}

model AiChat {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  title     String       @default("")
  type      AiChatType   @default(CHAT_ASSISTANT)
  status    AiChatStatus @default(ACTIVE)
  provider  String?
  model     String?
  metadata  Json?        @default("{}")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  user     User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, type, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([type, status, updatedAt(sort: Desc)])
  @@map("ai_chat")
}

model AiChatMessage {
  id        String     @id @default(uuid())
  chatId    String     @map("chat_id")
  userId    String?    @map("user_id")
  role      AiChatRole
  parts     Json?      @default("[]")
  provider  String?
  model     String?
  metadata  Json?      @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([role])
  @@map("ai_chat_message")
}

// ---- Course / Enrollment / Module / Lesson models based on ERD ----
model Course {
  id          String             @id @default(uuid())
  ownerId     String             @map("owner_id")
  owner       User               @relation("OwnerCourses", fields: [ownerId], references: [id])
  title       String
  description String?
  isPublished Boolean            @default(false) @map("is_published")
  modules     Module[]
  enrollments Enrollment[]
  permissions CoursePermission[]
  files       FileInventory[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  archivedAt  DateTime?          @map("archived_at")
  deletedAt   DateTime?          @map("deleted_at")
  questions   Question[]
  quizzes     Quiz[]

  @@index([deletedAt])
  @@index([archivedAt])
  @@map("course")
}

model Enrollment {
  id         String     @id @default(uuid())
  memberId   String     @map("member_id")
  member     User       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId     String     @map("role_id")
  role       CourseRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  courseId   String     @map("course_id")
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime   @default(now()) @map("enrolled_at")

  @@index([memberId])
  @@index([roleId])
  @@index([courseId, roleId])
  @@index([courseId])
  @@map("enrollment")
}

model Module {
  id         String    @id @default(uuid())
  courseId   String    @map("course_id")
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int       @default(0) @map("order_index")
  itemLayout Json?     @map("item_layout")
  lessons    Lesson[]
  deletedAt  DateTime? @map("deleted_at")

  @@index([courseId, deletedAt])
  @@map("module")
}

model Lesson {
  id                  String               @id @default(uuid())
  moduleId            String               @map("module_id")
  module              Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title               String
  content             Json?
  orderIndex          Int                  @default(0) @map("order_index")
  presentationDeckId  String?              @map("presentation_deck_id")
  presentationDeckKey String?              @map("presentation_deck_key")
  contentChunks       LessonContentChunk[]
  questions           Question[]
  lessonQuizzes       LessonQuiz[]
  deletedAt           DateTime?            @map("deleted_at")

  @@index([moduleId, deletedAt])
  @@map("lesson")
}

model LessonContentChunk {
  id String @id @default(uuid())

  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  contentHash String @map("content_hash")
  chunkIndex  Int    @map("chunk_index")
  markdown    String @db.Text
  tokenCount  Int    @map("token_count")

  embeddingModel String                      @map("embedding_model")
  embedding      Unsupported("vector(1536)")

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lessonId, chunkIndex])
  @@index([lessonId])
  @@index([contentHash])
  @@index([embedding], map: "lesson_content_chunk_embedding_hnsw_idx")
  @@map("lesson_content_chunk")
}

// ─── Quiz System ─────────────────────────────────────────────────────────────

enum QuizCategory {
  SELECTION_BASED
  OPEN_ENDED
}

enum QuestionSubType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  ORDERING
  ESSAY
  FILL_IN_THE_BLANK
  DRAG_AND_DROP
}

enum DeliveryMode {
  INSTANT_FEEDBACK
  POST_QUIZ_REVIEW
}

enum SelectionMethod {
  HAND_PICK
  RANDOM
  MANUAL_CREATE
}

enum WordbankReviewStatus {
  ACTIVE
  COMPLETED
}

model Question {
  id          String          @id @default(uuid())
  courseId    String          @map("course_id")
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?         @map("lesson_id")
  lesson      Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  category    QuizCategory
  subType     QuestionSubType @map("sub_type")
  prompt      String
  answerData  Json            @map("answer_data")
  explanation String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  quizQuestions QuizQuestion[]

  @@index([courseId])
  @@index([courseId, category, subType])
  @@index([lessonId])
  @@map("question")
}

model Quiz {
  id              String          @id @default(uuid())
  courseId        String          @map("course_id")
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonQuizzes   LessonQuiz[]
  title           String
  description     String?
  category        QuizCategory
  subType         QuestionSubType @map("sub_type")
  deliveryMode    DeliveryMode    @map("delivery_mode")
  selectionMethod SelectionMethod @map("selection_method")
  questionCount   Int             @map("question_count")
  questions       Json?           @default("[]")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  quizQuestions QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([courseId])
  @@map("quiz")
}

model LessonQuiz {
  lessonId String @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizId   String @map("quiz_id")
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([lessonId, quizId])
  @@index([quizId])
  @@map("lesson_quiz")
}

model QuizQuestion {
  id         String   @id @default(uuid())
  quizId     String   @map("quiz_id")
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0) @map("order_index")

  @@unique([quizId, questionId])
  @@index([quizId])
  @@map("quiz_question")
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers          Json
  score            Float
  maxScore         Float    @map("max_score")
  percentage       Float
  results          Json
  hasPendingReview Boolean  @default(false) @map("has_pending_review")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([quizId, userId])
  @@index([userId])
  @@map("quiz_attempt")
}

// ---- Saved Vocabulary ----

model SavedVocabulary {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  word                  String
  partOfSpeech          String   @map("part_of_speech")
  ipa                   String?
  audioUrl              String?  @map("audio_url")
  englishDefinition     String   @map("english_definition")
  vietnameseTranslation String   @map("vietnamese_translation")
  exampleSentence       String   @map("example_sentence")
  sourceSnippet         String?  @map("source_snippet")
  masteryLevel          Int      @default(0) @map("mastery_level")
  nextReviewAt          DateTime @default(now()) @map("next_review_at")

  savedAt DateTime @default(now()) @map("saved_at")

  listItems SavedVocabularyListItem[]

  @@unique([userId, word])
  @@index([userId, savedAt(sort: Desc)])
  @@index([userId, masteryLevel, nextReviewAt])
  @@map("saved_vocabulary")
}

model VocabularyList {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colorCode String?  @map("color_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items SavedVocabularyListItem[]

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
  @@map("vocabulary_list")
}

model SavedVocabularyListItem {
  savedVocabularyId String          @map("saved_vocabulary_id")
  listId            String          @map("list_id")
  savedVocabulary   SavedVocabulary @relation(fields: [savedVocabularyId], references: [id], onDelete: Cascade)
  list              VocabularyList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@id([savedVocabularyId, listId])
  @@index([listId])
  @@map("saved_vocabulary_list_item")
}

model WordbankReviewSession {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      WordbankReviewStatus @default(ACTIVE)
  quiz        Json
  clientQuiz  Json                 @map("client_quiz")
  wordMap     Json                 @map("word_map")
  createdAt   DateTime             @default(now()) @map("created_at")
  completedAt DateTime?            @map("completed_at")

  attempts WordbankReviewAttempt[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("wordbank_review_session")
}

model WordbankReviewAttempt {
  id         String                @id @default(uuid())
  sessionId  String                @map("session_id")
  session    WordbankReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String                @map("user_id")
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    Json
  score      Float
  maxScore   Float                 @map("max_score")
  percentage Float
  results    Json
  createdAt  DateTime              @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("wordbank_review_attempt")
}

// ─── Dictionary Cache ────────────────────────────────────────────────────────

model DictionaryCache {
  id        String   @id @default(uuid())
  word      String
  source    String   @default("free-dictionary")
  phonetic  String?
  audioUrl  String?  @map("audio_url")
  meanings  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([word, source])
  @@index([word, source])
  @@map("dictionary_cache")
}
