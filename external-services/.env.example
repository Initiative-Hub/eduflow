# OpenAI credentials
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter credentials. slide-skills routes here when OPENAI_API_KEY is absent
# and also fails over automatically on OpenAI quota (429) or auth (401) errors,
# so deck generation keeps working when OpenAI billing runs out.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: overrides the first image model tried through OpenRouter.
# Note: some providers refuse requests by region (Google AI Studio answers
# 400 "User location is not supported", OpenAI 403 "Country, region, or
# territory not supported"). google/gemini-2.5-flash-image and
# bytedance-seed/seedream-4.5 are known to work more widely.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Tavily Web Search credentials
TAVILY_API_KEY=your_tavily_api_key_here

# S3/MinIO Configuration
AWS_REGION=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=eduflow-inventory
AWS_S3_TEMPLATES_BUCKET=eduflow-template
AWS_S3_DEFAULT_TEMPLATES_BUCKET=eduflow-default-template