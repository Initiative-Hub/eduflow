# OpenRouter credentials. slide-skills routes here when OPENAI_API_KEY is absent
# and also fails over automatically on OpenAI quota (429) or auth (401) errors,
# so deck generation keeps working when OpenAI billing runs out.
OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Tavily Web Search credentials
TAVILY_API_KEY=your_tavily_api_key_here

# S3/MinIO Configuration
AWS_REGION=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=eduflow-inventory
AWS_S3_TEMPLATES_BUCKET=eduflow-template
AWS_S3_DEFAULT_TEMPLATES_BUCKET=eduflow-default-template
# --- slide generation performance -------------------------------------------
# Slides built concurrently. Each holds a model call open, so this is the deck's
# concurrency, not its CPU budget.
SLIDE_SKILLS_DECK_WORKERS=8
# Image generations in flight across the whole deck. Capping here rather than
# per slide lets a gallery's three pictures render together.
SLIDE_SKILLS_IMAGE_CONCURRENCY=6
# Use a slide's planned bindings verbatim when they already fill every content
# slot, instead of a model call per slide to rewrite copy the planner wrote.
# Covers and section dividers, whose extra copy the planner does not supply,
# still go to the model.
SLIDE_SKILLS_TRUST_BINDINGS=1
# Seconds to memoise the style inventory (lists both template buckets).
SLIDE_COLLECTIONS_CACHE_SECONDS=60
